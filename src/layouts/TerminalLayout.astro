---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<BaseLayout title={title} description={description} bodyClass="terminal">
  <div
    class:list={[
      "mx-auto px-5 py-10 sm:px-8 sm:py-14",
      wide ? "max-w-6xl" : "max-w-3xl",
    ]}
  >
    <slot />
  </div>
</BaseLayout>
