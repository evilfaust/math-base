---
import "@fontsource-variable/jetbrains-mono";
import "@fontsource-variable/inter";
import "@fontsource-variable/literata";
import "~/styles/global.css";

interface Props {
  title: string;
  description?: string;
  bodyClass?: string;
  /** Картинка для превью ссылки. Абсолютный URL соберём сами. */
  image?: string;
  /** Для записей блога — влияет на og:type и article:*. */
  article?: {
    published?: Date;
    modified?: Date;
    section?: string;
    tags?: string[];
  };
}

const {
  title,
  description = "Хаб проектов, инструментов и заметок. Преподавание математики, разработка, эксперименты.",
  bodyClass = "",
  image,
  article,
} = Astro.props;

const site = Astro.site ?? new URL("https://oipav.ru");
const canonical = new URL(Astro.url.pathname, site);
// Соцсети не понимают относительные пути — og:image всегда абсолютный.
const ogImage = new URL(image ?? "/og-default.png", site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="oipav.ru" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      article && (
        <>
          {article.published && (
            <meta
              property="article:published_time"
              content={article.published.toISOString()}
            />
          )}
          {article.modified && (
            <meta
              property="article:modified_time"
              content={article.modified.toISOString()}
            />
          )}
          {article.section && (
            <meta property="article:section" content={article.section} />
          )}
          {article.tags?.map((t) => <meta property="article:tag" content={t} />)}
        </>
      )
    }

    <title>{title}</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
