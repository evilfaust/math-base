---
import EditorialLayout from "~/layouts/EditorialLayout.astro";
import { render } from "astro:content";
import readingTime from "reading-time";
import { categoryUrl, fmtDate, getPosts, tagUrl } from "~/lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      // Соседние записи для навигации в конце статьи. Список отсортирован
      // от новых к старым, поэтому "следующая" — это предыдущий индекс.
      newer: posts[i - 1] ?? null,
      older: posts[i + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const rt = readingTime(post.body ?? "").minutes;
const rtLabel = `${Math.max(1, Math.round(rt))} мин чтения`;
---

<EditorialLayout
  title={`${post.data.title} — Блог`}
  description={post.data.description}
  image={post.data.cover}
  article={{
    published: post.data.date,
    modified: post.data.updated,
    section: post.data.category,
    tags: post.data.tags,
  }}
>
  <article>
    <div class="kicker mb-3">
      {fmtDate(post.data.date)} ·{" "}
      <a href={categoryUrl(post.data.category)}>{post.data.category}</a> · {rtLabel}
    </div>
    <h1 class="mb-3 text-3xl leading-tight sm:text-4xl">{post.data.title}</h1>
    {
      post.data.description && (
        <p class="mb-8 text-lg" style="color: var(--color-paper-muted);">
          {post.data.description}
        </p>
      )
    }

    {
      post.data.cover && (
        <img class="cover" src={post.data.cover} alt="" decoding="async" />
      )
    }

    {
      post.data.updated && (
        <p class="kicker mb-8">Обновлено {fmtDate(post.data.updated)}</p>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      post.data.tags.length > 0 && (
        <ul class="tag-row rule mt-12 pt-6">
          {post.data.tags.map((t) => (
            <li>
              <a href={tagUrl(t)}>#{t}</a>
            </li>
          ))}
        </ul>
      )
    }

    {
      (newer || older) && (
        <nav class="pager rule mt-8 pt-6">
          {older ? (
            <a href={`/blog/${older.id}`} class="pager-link">
              <span class="kicker">← Предыдущая</span>
              <span class="pager-title">{older.data.title}</span>
            </a>
          ) : (
            <span />
          )}
          {newer && (
            <a href={`/blog/${newer.id}`} class="pager-link pager-next">
              <span class="kicker">Следующая →</span>
              <span class="pager-title">{newer.data.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</EditorialLayout>

<style>
  .cover {
    display: block;
    width: 100%;
    margin: 0 0 2rem;
    border-radius: 8px;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: rgba(0, 0, 0, 0.04);
  }

  .tag-row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin: 0;
    padding-left: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
  .tag-row a {
    color: var(--color-paper-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-paper-rule);
  }
  .tag-row a:hover {
    color: var(--color-paper-accent);
    border-bottom-color: currentColor;
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-decoration: none;
    color: var(--color-paper-fg);
  }
  .pager-next {
    text-align: right;
  }
  .pager-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .pager-link:hover .pager-title {
    color: var(--color-paper-accent);
  }
</style>
