---
import TerminalLayout from "~/layouts/TerminalLayout.astro";
import { projects } from "~/data/projects";
import { fetchAllRepos } from "~/lib/github";
import { getCollection } from "astro:content";

const ghData = await fetchAllRepos(projects.map((p) => p.repo));

const statusLabel = {
  public: "открыт",
  soon: "скоро",
  private: "закрыт",
} as const;

// GitHub's own language colours — free vividness, and it reads as data, not decoration.
const langColor: Record<string, string> = {
  JavaScript: "#f1e05a",
  TypeScript: "#3178c6",
  HTML: "#e34c26",
  CSS: "#663399",
  Python: "#3572a5",
  Astro: "#ff5d01",
  Vue: "#41b883",
  Shell: "#89e051",
};

const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const totalStars = Object.values(ghData).reduce(
  (sum, gh) => sum + (gh?.stars ?? 0),
  0,
);
const liveCount = projects.filter((p) => p.website).length;

const stats = [
  { value: projects.length, label: "проекта", color: "#a78bfa" },
  { value: liveCount, label: "сайта онлайн", color: "#34d399" },
  { value: posts.length, label: "записи", color: "#38bdf8" },
  ...(totalStars > 0
    ? [{ value: totalStars, label: "звёзд", color: "#ffb020" }]
    : []),
];

const rtf = new Intl.RelativeTimeFormat("ru", { numeric: "auto" });
function lastPush(iso: string): string | null {
  if (!iso) return null;
  const days = Math.round((Date.now() - +new Date(iso)) / 86_400_000);
  if (!Number.isFinite(days)) return null;
  if (days < 30) return rtf.format(-days, "day");
  if (days < 365) return rtf.format(-Math.round(days / 30), "month");
  return rtf.format(-Math.round(days / 365), "year");
}

const fmtDate = (d: Date) =>
  d.toLocaleDateString("ru-RU", { day: "numeric", month: "short" });
const year = new Date().getFullYear();

// A short post list would leave dead cells in the grid, so a CTA card fills the
// row until there are enough posts to stand on their own.
const showBlogCta = posts.length < 3;
const blogCells = posts.length + (showBlogCta ? 1 : 0);
const blogCols =
  blogCells >= 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2";
---

<TerminalLayout title="oipav.ru — хаб проектов" wide>
  <header class="mb-14 flex items-center justify-between gap-4 text-sm">
    <a href="/" class="flex items-center gap-2.5" aria-label="oipav.ru — главная">
      <span
        class="grid h-8 w-8 place-items-center rounded-lg text-xs font-bold text-black"
        style="background: linear-gradient(135deg, #ffb020, #f472b6 55%, #a78bfa);"
        aria-hidden="true">&gt;_</span
      >
      <span><span class="accent">~</span><span class="muted">/oipav.ru</span></span>
    </a>
    <nav class="flex items-center gap-5 text-xs">
      <a href="/blog" class="underline-link">blog →</a>
      <a
        href="https://github.com/evilfaust"
        target="_blank"
        rel="noopener noreferrer"
        class="underline-link">github →</a
      >
    </nav>
  </header>

  <section class="mb-16" data-reveal>
    <p class="prompt mb-4 text-sm muted">whoami</p>
    <h1
      class="max-w-3xl text-3xl leading-[1.15] font-semibold tracking-tight sm:text-5xl"
    >
      Преподаю математику<span class="accent">.</span><br />
      <span class="grad">Строю инструменты</span><span class="accent">.</span
      ><span class="caret ml-1.5" aria-hidden="true"></span>
    </h1>
    <p
      class="mt-6 max-w-2xl font-sans text-base leading-relaxed sm:text-lg"
      style="color: var(--color-terminal-muted);"
    >
      Собираю собственные цифровые инструменты вокруг этой работы — от
      генераторов заданий и тестов до небольших сервисов и заметок.
    </p>

    <dl class="mt-9 flex flex-wrap gap-x-10 gap-y-5">
      {
        stats.map((s) => (
          <div>
            <dt class="sr-only">{s.label}</dt>
            <dd>
              <span
                class="block text-3xl font-semibold tabular-nums sm:text-4xl"
                style={`color: ${s.color}`}
              >
                {s.value}
              </span>
              <span class="mt-0.5 block text-xs muted">{s.label}</span>
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mb-16">
    <div class="mb-5 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
      <p class="prompt text-sm muted">ls ~/projects/</p>
      <ul class="flex items-center gap-4 text-xs muted">
        {
          (["public", "soon", "private"] as const).map((s) => (
            <li class="flex items-center gap-1.5">
              <span class="status" data-s={s}>
                <span class="dot block" />
              </span>
              {statusLabel[s]}
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        projects.map((p, i) => {
          const gh = ghData[p.repo];
          const updated = gh ? lastPush(gh.pushedAt) : null;
          const repoUrl = `https://github.com/${p.repo}`;
          const href = p.website ?? repoUrl;
          return (
            <li
              class:list={["card", p.featured && "lg:col-span-2"]}
              style={`--a: ${p.accent}; --d: ${80 + Math.min(i, 6) * 55}ms`}
              data-reveal
            >
              <div class="flex items-start gap-3.5">
                <span
                  class:list={["tile", p.featured && "tile-lg"]}
                  aria-hidden="true"
                >
                  {p.name.charAt(0)}
                </span>
                <div class="min-w-0 flex-1">
                  <h2
                    class:list={[
                      "leading-tight font-semibold",
                      p.featured ? "text-xl" : "text-base",
                    ]}
                  >
                    <a href={href} target="_blank" rel="noopener noreferrer">
                      <span style="color: var(--a-text)">{p.name}</span>
                      <span class="absolute inset-0 z-10" aria-hidden="true" />
                    </a>
                  </h2>
                  <p class="mt-1 flex items-center gap-1.5 text-xs">
                    <span class="status inline-flex items-center" data-s={p.status}>
                      <span class="dot block" data-s={p.status} />
                    </span>
                    <span class="muted">{statusLabel[p.status]}</span>
                    {p.featured && (
                      <span class="ml-1 muted" style="color: var(--a-text)">
                        · избранное
                      </span>
                    )}
                  </p>
                </div>
              </div>

              <p
                class:list={[
                  "mt-3.5 font-sans leading-relaxed",
                  p.featured ? "text-[15px]" : "text-sm",
                ]}
                style="color: var(--color-terminal-fg-soft)"
              >
                {p.description}
              </p>

              <ul class="mt-3.5 flex flex-wrap gap-1.5">
                {p.tags.map((t) => (
                  <li class="chip">#{t}</li>
                ))}
              </ul>

              <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-1.5 pt-4 text-xs muted">
                {gh?.language && (
                  <span class="flex items-center gap-1.5">
                    <span
                      class="h-2 w-2 rounded-full"
                      style={`background: ${langColor[gh.language] ?? "#8b949e"}`}
                      aria-hidden="true"
                    />
                    {gh.language}
                  </span>
                )}
                {gh && gh.stars > 0 && (
                  <span class="flex items-center gap-1">
                    <svg
                      class="h-3 w-3"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.9L12 17.8 5.8 21l1.2-6.9-5-4.9 6.9-1z" />
                    </svg>
                    {gh.stars}
                  </span>
                )}
                {updated && <span>обновлён {updated}</span>}
                <span class="relative z-20 ml-auto flex items-center gap-3">
                  {p.demoUrl && (
                    <a
                      href={p.demoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link"
                    >
                      демо
                    </a>
                  )}
                  <a
                    href={repoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link"
                    aria-label={`Репозиторий ${p.name} на GitHub`}
                  >
                    <svg
                      class="h-4 w-4"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 .5a11.5 11.5 0 0 0-3.6 22.4c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.4-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.8 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.5-2.7 5.5-5.3 5.8.4.4.8 1.1.8 2.2v3.3c0 .4.2.7.8.6A11.5 11.5 0 0 0 12 .5Z" />
                    </svg>
                    {/* Without a website the icon would sit alone, so label it. */}
                    {!p.website && <span>исходный код</span>}
                  </a>
                  {p.website && (
                    <a
                      href={p.website}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link"
                    >
                      {p.website.replace(/^https?:\/\//, "")}
                      <svg
                        class="h-3 w-3"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M7 17 17 7M8 7h9v9" />
                      </svg>
                    </a>
                  )}
                </span>
              </div>
            </li>
          );
        })
      }
    </ul>
  </section>

  {
    posts.length > 0 && (
      <section class="mb-16">
        <div class="mb-5 flex items-baseline justify-between gap-4">
          <p class="prompt text-sm muted">ls ~/blog/</p>
          <a href="/blog" class="underline-link text-xs">
            все записи →
          </a>
        </div>
        <ul class:list={["grid gap-4", blogCols]}>
          {posts.map((p, i) => (
            <li class="card" style={`--a: #38bdf8; --d: ${i * 55}ms`} data-reveal>
              <p class="text-xs muted">
                {fmtDate(p.data.date)} · {p.data.category}
              </p>
              <h3 class="mt-2 text-base leading-snug font-semibold">
                <a href={`/blog/${p.id}`} style="color: var(--a-text)">
                  {p.data.title}
                  <span class="absolute inset-0 z-10" aria-hidden="true" />
                </a>
              </h3>
              {p.data.description && (
                <p
                  class="mt-2 font-sans text-sm leading-relaxed"
                  style="color: var(--color-terminal-fg-soft)"
                >
                  {p.data.description}
                </p>
              )}
              {p.data.tags.length > 0 && (
                <ul class="mt-auto flex flex-wrap gap-1.5 pt-4">
                  {p.data.tags.map((t) => (
                    <li class="chip">#{t}</li>
                  ))}
                </ul>
              )}
            </li>
          ))}
          {showBlogCta && (
            <li
              class="card card-cta"
              style={`--a: #ffb020; --d: ${posts.length * 55}ms`}
              data-reveal
            >
              <a href="/blog" class="link text-sm">
                Все записи в блоге
                <svg
                  class="h-3.5 w-3.5"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 6l6 6-6 6" />
                </svg>
                <span class="absolute inset-0 z-10" aria-hidden="true" />
              </a>
              <p class="mt-2 text-xs muted">
                Заметки о математике, преподавании и инструментах
              </p>
            </li>
          )}
        </ul>
      </section>
    )
  }

  <footer
    class="flex flex-wrap items-baseline justify-between gap-4 border-t pt-6 text-xs muted"
    style="border-color: rgba(255,255,255,0.08)"
  >
    <span>evilfaust · {year}</span>
    <span>built with <span class="accent">astro</span> · static</span>
  </footer>
</TerminalLayout>
